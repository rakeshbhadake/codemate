# Public browser configuration (required for local development and Vercel builds).
# These values are embedded in the browser bundle; use only the Supabase anon/publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only Gemini key for Supabase Edge Functions (optional AI features).
# Configure the real value in Supabase Edge Function Secrets, never as a VITE_ variable.
# GEMINI_API_KEY=your-gemini-api-key

# Supabase provides these to Edge Functions. Do not add them to Vercel or expose them with VITE_.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
